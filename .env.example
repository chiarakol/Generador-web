# ---- Modo ----
DRY_RUN=true                       # true = escribe JSONL local; false = publica a Event Hubs
OUTPUT_DIR=output

# ---- Azure Event Hubs (solo si DRY_RUN=false) ----
EVENT_HUB_CONNECTION_STRING=       # nivel namespace; NO versionar
EVENT_HUB_NAME_FEATURES=eventos-features
EVENT_HUB_NAME_GROUND_TRUTH=eventos-ground-truth
USE_MANAGED_IDENTITY=false
EVENT_HUB_NAMESPACE=mi-namespace.servicebus.windows.net
# Reintentos del productor (5.5). Lo que falla tras todos los intentos va a
# OUTPUT_DIR/no_enviados_<fecha>.jsonl (nada se descarta en silencio). No afecta el dataset.
PRODUCTOR_INTENTOS=4               # intentos totales por sub-lote (1 = sin reintento)
PRODUCTOR_ESPERA_INICIAL_SEG=1     # se duplica en cada reintento...
PRODUCTOR_ESPERA_MAX_SEG=30        # ...hasta este tope

# ---- Reloj simulado (RELOJ_ESCALA debe ser IGUAL en el generador y en el job CAL) ----
RELOJ_ESCALA=3600                  # segundos simulados por segundo real (6 meses ~ 73 min)
GENERATOR_INTERVAL_SECONDS=2
HORIZONTE_DIAS=182
WARMUP_DIAS=60
SIM_START=2026-01-01T00:00:00Z

# ---- Mundo ----
NUM_COMPRADORES=2000
NUM_PROVEEDORES=400
PCT_HIBRIDAS=0.05
PCT_GRUPOS=0.06
CYCLE_DETECTION_MAX_HOPS=6
MONTO_MEDIANA_BASE=4500
MONTO_SIGMA_LOG=0.65
PROB_CUENTA_EXTRANJERA_PROVEEDOR=0.05  # proveedores organicos con cuenta en otro pais desde el alta
                                   # (negativo duro de la senal de pais de cuenta de T2)
REVISION_LIMITE_DIAS_MEDIA=180     # Fase 4 (3.2a, B4-T5): revisiones organicas de limite de credito;
                                   # 0 = desactivado (reproduce la fuga: todo cambio de limite era bust_out)

# ---- Fraude por tipologias ----
PREVALENCIA=0.01                   # con 0.01 hay solo 1-2 campanas de T2/T3/T5 en 6 meses
MEZCLA_TIPOLOGIAS=T1:25,T2:10,T3:10,T4:15,T5:10,T6:15,T7:5,T8:10
MIN_CAMPANAS_TIPOLOGIA=6           # Fase 2 (A4): antes 0 -- T2/T3/T5 quedaban en 1-2 campanas
MIN_CAMPANAS_BUST_OUT=6            # T5 no usa el controlador continuo, necesita su propio minimo
RUIDO_ETIQUETA_FN=0.05
RUIDO_ETIQUETA_FP=0.005
RUIDO_ETIQUETA_SISTEMATICO=false     # true = modula RUIDO_ETIQUETA_FN por tipologia (ver DIFICULTAD_FN en tipologias.py)
DERIVA_INTENSIDAD=0.0               # decision deliberada (Fase 1, A6): queda en 0 en el dataset
                                     # base para no mezclar "deteccion estatica" con "adaptacion
                                     # del fraudador" en la misma corrida. Para medir deriva/OE2,
                                     # usar una corrida SEPARADA y declarada con este valor > 0,
                                     # nunca como default silencioso. Con lazo abierto (el generador
                                     # no reacciona a las decisiones del detector) esto sigue siendo
                                     # un decaimiento programado, no una adaptacion real -- ver A6
                                     # en docs/roadmap_correccion.md.

# ---- Densidad ----
EVENTOS_POR_HORA_SIM=12             # Fase 2 (B6): antes 5.0 -- techo del rango que la rejilla
                                     # de sensibilidad (2.4) confirmo estable; sube la mediana
                                     # de compras/comprador de 3 a 7 en 6 meses

# ---- Negativos duros (fraccion de compras organicas deliberadamente dificiles) ----
NEGATIVOS_DUROS=0.02                # rafaga de reposicion de inventario (varias ordenes seguidas)
NEGATIVOS_DUROS_LIMITE=0.04         # Fase 2 (B2): monto cerca del limite de aprobacion, SIN ser
                                     # fraude -- mismo rango amplio que usan T2/T4, para que esa
                                     # cercania deje de ser casi exclusiva del fraude

# ---- Reproducibilidad ----
SEED=42
